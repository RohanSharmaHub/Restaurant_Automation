{
  "permissions": {
    "allow": [
      "Bash(.venv/bin/pip install *)",
      "Bash(curl -sS -o /dev/null -w \"GET /            -> %{http_code}\\\\n\" http://127.0.0.1:5000/)",
      "Bash(curl -sS -o /dev/null -w \"GET /auth/login  -> %{http_code}\\\\n\" http://127.0.0.1:5000/auth/login)",
      "Bash(curl -sS -o /dev/null -w \"GET /dashboard   -> %{http_code}  \\(expect 302 redirect to login\\)\\\\n\" http://127.0.0.1:5000/dashboard)",
      "Bash(curl -sS -o /dev/null -w \"GET /nonexistent -> %{http_code}\\\\n\" http://127.0.0.1:5000/nonexistent)",
      "Bash(lsof -nP -iTCP:5000 -sTCP:LISTEN)"
    ]
  }
}
